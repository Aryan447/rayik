---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { THEMES } from '../data/themes';
import { readFileSync } from 'node:fs';

// Direct-download URLs baked at build time from the app version — no API
// needed: github.com/<owner>/<repo>/releases/download/<tag>/<asset>
// redirects straight to the file. Works the moment the tag is published
// (drafts 404, which is correct — nothing to download yet).
const REPO = 'Aryan447/rayik';
const gradle = readFileSync(new URL('../../../../app/build.gradle.kts', import.meta.url), 'utf8');
const APP_VERSION = gradle.match(/versionName\s*=\s*"([^"]+)"/)?.[1] ?? '0.0.0';
const TAG = `v${APP_VERSION}`;
const APK_NAME = `rayik-universal-${TAG}.apk`;
const AAB_NAME = `rayik-universal-${TAG}.aab`;
const APK_URL = `https://github.com/${REPO}/releases/download/${TAG}/${APK_NAME}`;
const AAB_URL = `https://github.com/${REPO}/releases/download/${TAG}/${AAB_NAME}`;
const RELEASES_PAGE = `https://github.com/${REPO}/releases`;

// Stroke icons in the mark's language: 24 grid, 1.75 stroke, round caps.
const STROKE = 'fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"';
const svg = (inner: string) => `<svg viewBox="0 0 24 24" ${STROKE} aria-hidden="true">${inner}</svg>`;
const ICONS: Record<string, string> = {
  bars: svg('<path d="M5 8v8M8.5 5v14M12 2v20M15.5 5v14M19 8v8"/>'),
  search: svg('<circle cx="11" cy="11" r="6.5"/><path d="M16 16l4.5 4.5"/>'),
  lyrics: svg('<path d="M4 7h16M4 12h16M4 17h10"/>'),
  download: svg('<path d="M12 4v10M7.5 10.5L12 15l4.5-4.5M4.5 19h15"/>'),
  pin: svg('<path d="M12 21s-7-7.6-7-12a7 7 0 0 1 14 0c0 4.4-7 12-7 12z"/><circle cx="12" cy="9" r="2.5"/>'),
  calendar: svg('<rect x="4.5" y="6" width="15" height="14" rx="2"/><path d="M4.5 10h15M9 3.5V7M15 3.5V7"/>'),
  car: svg('<path d="M5 16l1.5-5h11L19 16M4 16h16v2.5H4z"/><circle cx="8" cy="18.5" r="1.4"/><circle cx="16" cy="18.5" r="1.4"/>'),
  gauge: svg('<path d="M5 19a8 8 0 0 1 14 0"/><path d="M12 19l3.5-6.5"/><circle cx="12" cy="19" r="1.2" fill="currentColor"/>'),
  spark: svg('<path d="M12 3l1.8 7.2L21 12l-7.2 1.8L12 21l-1.8-7.2L3 12l7.2-1.8z"/>'),
  heart: svg('<path d="M12 20.6C6.8 16.2 3.8 13 3.8 9.4 3.8 6.9 5.8 5 8.3 5c1.6 0 2.9.9 3.7 2.2C12.8 5.9 14.1 5 15.7 5c2.5 0 4.5 1.9 4.5 4.4 0 3.6-3 6.8-8.2 11.2z"/>'),
  quote: svg('<path d="M5 6h12v9H9.5L7 18.5V15H5z"/>'),
};
const BARS_ART = `<svg viewBox="0 0 108 108" aria-hidden="true"><defs><linearGradient id="mg" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#FFF5D4"/><stop offset=".3" stop-color="#F2CE62"/><stop offset=".7" stop-color="#DEAC33"/><stop offset="1" stop-color="#9C6E15"/></linearGradient></defs><rect x="31.25" y="44" width="5.5" height="20" rx="2.75" fill="url(#mg)"/><rect x="41.25" y="37" width="5.5" height="34" rx="2.75" fill="url(#mg)"/><rect x="51.25" y="30" width="5.5" height="48" rx="2.75" fill="url(#mg)"/><rect x="61.25" y="37" width="5.5" height="34" rx="2.75" fill="url(#mg)"/><rect x="71.25" y="44" width="5.5" height="20" rx="2.75" fill="url(#mg)"/></svg>`;

const FEATURES: { icon: string; tag?: string; h: string; p: string }[] = [
  { icon: 'bars', h: 'Albums flow perfectly', p: 'Songs melt into each other exactly how the artist meant. No gaps, no jolts.' },
  { icon: 'search', h: 'Find it with one line', p: 'Only remember a single lyric? That\u2019s plenty — type it, hear it.' },
  { icon: 'lyrics', h: "Lyrics and what's next, together", p: 'Sing along and see the queue on one screen. No tab-hopping mid-song.' },
  { icon: 'download', h: 'Bring your playlists', p: 'Years of Spotify playlists move with you in one tap. Nothing left behind.' },
  { icon: 'pin', h: 'Offline for the metro', p: 'Pin favorites for tunnels and flights. rāyik tidies up the rest by itself.' },
  { icon: 'calendar', h: 'A year in review', p: 'Wrapped turns your on-device history into story pages — minutes, top songs, peak hour.' },
  { icon: 'car', tag: 'Planned', h: 'At home in your car', p: 'Car screen support is on the roadmap — pause, skip, and go, coming after v1.' },
  { icon: 'gauge', h: 'Honest streaming quality', p: 'Saver, Auto, or High — your call, everywhere. No fine print, no fake badges.' },
  { icon: 'calendar', tag: 'Planned', h: 'A fresh mix every week', p: 'Weekly mixes plus radio that never runs dry. Coming after v1.' },
  { icon: 'spark', h: 'Expressive by design', p: 'The whole app is drawn with Material 3 Expressive — springy pills, glass sheets, motion with intent.' },
];
---
<!DOCTYPE html>
<html lang="en" data-theme="gold">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>rāyik — music with opinions | Download for Android</title>
<meta name="description" content="rāyik is a new music app with opinions. It tells you what it thinks and why — you always get the last word. Free download for Android.">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
</head>
<body>
<header class="hero">
  <div class="wrap">
    <Logo />
    <div class="badge"><span id="heroVersion">{TAG}</span> &bull; Free forever</div>
    <h1>r<span>ā</span>yik</h1>
    <div class="tagline">Music with opinions.</div>
    <p class="sub">rāyik doesn&rsquo;t just play what you ask — it tells you what it thinks, and why. You always get the last word.</p>
    <div class="cta-row">
      <a class="btn btn-primary" id="dlHero" href={APK_URL}>Download for Android</a>
      <a class="btn btn-ghost" href="#themes">Pick your vibe</a>
    </div>
    <p class="soon-note" id="dlHeroNote">Direct download: {APK_NAME}</p>
  </div>
</header>

<div class="wrap">
<section id="themes">
  <h2>Pick your <span>vibe.</span></h2>
  <p class="sec-sub">Sixteen handcrafted looks, from low-light vinyl to full Indian street color. Tap any name and this whole page changes — that&rsquo;s exactly how it will feel in the app.</p>
  <div class="picker" id="picker" role="group" aria-label="Theme picker">
    {THEMES.map((t) => (
      <button data-k={t.k} data-theme-btn aria-pressed={t.k === 'gold' ? 'true' : 'false'}>
        <span class="dot" style={`background:${t.c}`}></span>{t.n}
      </button>
    ))}
  </div>
  <div class="grid" id="themeGrid">
    {THEMES.map((t) => (
      <div class="card" data-theme-card={t.k} style="cursor:pointer;">
        <div class="kind">{t.mood}</div>
        <h3>{t.n}</h3>
        <p>{t.d}</p>
        <div class="swatches">
          <div class="sw" style={`background:${t.c}`}></div>
          <div class="sw" style={`background:${t.s}`}></div>
          <div class="sw" style={`background:${t.t}`}></div>
        </div>
      </div>
    ))}
  </div>
</section>

<section id="player">
  <h2>It has <span>taste.</span></h2>
  <p class="sec-sub">Open rāyik in the morning and it already has a thought waiting — with the reason attached. Agree, skip, or tell it why it&rsquo;s wrong. Every pixel drawn with Material 3 Expressive.</p>
  <div class="player-mock">
    <div class="art" set:html={BARS_ART}></div>
    <div>
      <div class="reason">A slow morning pour, strings first</div>
      <h3>Mehfil Mix — Rain Edition</h3>
      <div class="mock-bars" aria-hidden="true"><i style="height:40%"></i><i style="height:70%"></i><i style="height:100%"></i><i style="height:70%"></i><i style="height:40%"></i></div>
      <div class="bar"></div>
      <div class="chips"><span class="chip hot"><svg viewBox="0 0 24 24" width="10" height="10" aria-hidden="true"><path d="M8 5.5v13l10-6.5z" fill="currentColor"/></svg> Play</span><span class="chip">Something else</span></div>
    </div>
  </div>
  <div class="feat-grid" style="margin-top:14px;">
    <div class="feat"><div class="icon" set:html={ICONS.bars}></div><h3>Moods, not menus</h3><p>Focus, rain, drive, mehfil — your day already has a soundtrack, rāyik just follows it.</p></div>
    <div class="feat"><div class="icon" set:html={ICONS.heart}></div><h3>You train it</h3><p>Love it, skip it. Every tap sharpens tomorrow morning&rsquo;s pick.</p></div>
    <div class="feat"><div class="icon" set:html={ICONS.quote}></div><h3>It shows its work</h3><p>Every suggestion comes with its reason. No black-box shuffling.</p></div>
  </div>
</section>

<section id="features">
  <h2>Everything you <span>love.</span></h2>
  <p class="sec-sub">The best bits of every music app you&rsquo;ve used — in one place, without the clutter.</p>
  <div class="feat-grid">
    {FEATURES.map((f) => (
      <div class="feat"><div class="icon" set:html={ICONS[f.icon]}></div><h3>{f.h}{f.tag && <span class="tag">{f.tag}</span>}</h3><p>{f.p}</p></div>
    ))}
  </div>
</section>

<section class="coming" id="download">
  <div class="badge" id="dlBadge">Latest release {TAG}</div>
  <h2>Get <span>rāyik.</span></h2>
  <p class="sec-sub" style="margin:0 auto 22px;" id="dlMeta">{APK_NAME}</p>
  <div class="cta-row">
    <a class="btn btn-primary" id="dlMain" href={APK_URL}>Download {APK_NAME}</a>
    <a class="btn btn-ghost" href={RELEASES_PAGE}>All releases</a>
  </div>
  <p class="soon-note">Prefer the bundle? <a href={AAB_URL} style="color:var(--primary);">Download {AAB_NAME}</a></p>
  <p class="soon-note">Free forever &bull; GPL-3.0 &bull; No Play Store &mdash; unofficial clients get removed there. F-Droid is planned.<br>Unofficial community client. Not affiliated with Google or YouTube.</p>
</section>

<footer>rāyik &mdash; music with opinions. Free forever &bull; GPL-3.0.</footer>
</div>

<script is:inline>
const rootEl = document.documentElement;
function setTheme(k) {
  rootEl.setAttribute('data-theme', k);
  document.querySelectorAll('[data-theme-btn]').forEach((b) => {
    b.setAttribute('aria-pressed', b.dataset.k === k ? 'true' : 'false');
  });
}
document.querySelectorAll('[data-theme-btn]').forEach((b) => {
  b.addEventListener('click', () => setTheme(b.dataset.k));
});
document.querySelectorAll('[data-theme-card]').forEach((c) => {
  c.addEventListener('click', () => setTheme(c.dataset.themeCard));
});

const RELEASES_API = 'https://api.github.com/Aryan447/rayik/releases/latest';
function fmtMB(b) { return (b / 1048576).toFixed(1) + ' MB'; }
function fmtDate(iso) {
  try { return new Date(iso).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' }); }
  catch (e) { return ''; }
}
async function loadRelease() {
  const heroBtn = document.getElementById('dlHero'), heroNote = document.getElementById('dlHeroNote');
  const mainBtn = document.getElementById('dlMain'), meta = document.getElementById('dlMeta');
  const badge = document.getElementById('dlBadge'), heroVer = document.getElementById('heroVersion');
  try {
    const r = await fetch(RELEASES_API, { headers: { 'Accept': 'application/vnd.github+json' } });
    if (!r.ok) throw new Error('http ' + r.status);
    const j = await r.json();
    const assets = j.assets || [];
    const apk = assets.find((a) => /\.apk$/i.test(a.name) && /universal/i.test(a.name))
      || assets.find((a) => /\.apk$/i.test(a.name));
    const tag = j.tag_name || '';
    if (heroVer && tag) heroVer.textContent = tag;
    if (badge && tag) badge.textContent = 'Latest release ' + tag;
    if (apk) {
      // A newer published release than the baked-in build: point at it.
      const label = 'rāyik ' + tag + ' • ' + fmtMB(apk.size || 0) + ' • ' + fmtDate(apk.updated_at || j.published_at);
      if (meta) meta.textContent = label;
      if (mainBtn) { mainBtn.href = apk.browser_download_url; mainBtn.textContent = 'Download ' + apk.name; }
      if (heroBtn) { heroBtn.href = apk.browser_download_url; }
      if (heroNote) heroNote.textContent = label + ' — tapped from GitHub Releases, always the newest build.';
    }
    // No direct asset (or API unreachable): the baked-in
    // releases/download/ links from the build stay as they are.
  } catch (e) { /* baked-in links stand */ }
}
loadRelease();
</script>
</body>
</html>
