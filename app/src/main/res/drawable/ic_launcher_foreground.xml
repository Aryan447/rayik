<?xml version="1.0" encoding="utf-8"?>
<!-- rāyik launcher foreground: the one mark — five gradient gold bars inside
     two acoustic rings (site Logo.astro, in-app RayikMark). The dark radial
     tile comes from ic_launcher_background. Strict 66dp safe zone, 108 grid. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Concentric acoustic rings (soundstage / streaming orbit) -->
    <path
        android:strokeColor="#EAC453"
        android:strokeWidth="1.4"
        android:strokeAlpha="0.35"
        android:strokeLineCap="round"
        android:pathData="M 25,54 a 29,29 0 1,0 58,0 a 29,29 0 1,0 -58,0" />
    <path
        android:strokeColor="#EAC453"
        android:strokeWidth="0.8"
        android:strokeAlpha="0.20"
        android:strokeLineCap="round"
        android:pathData="M 29,54 a 25,25 0 1,0 50,0 a 25,25 0 1,0 -50,0" />

    <!-- Five gold equalizer bars (heights 20 / 34 / 48 / 34 / 20) -->
    <path android:fillColor="@color/rayik_gold_gradient" android:pathData="M 31.25,46.75 a2.75,2.75 0 0 1 2.75,-2.75 a2.75,2.75 0 0 1 2.75,2.75 L 36.75,61.25 a2.75,2.75 0 0 1 -2.75,2.75 a2.75,2.75 0 0 1 -2.75,-2.75 Z" />
    <path android:fillColor="@color/rayik_gold_gradient" android:pathData="M 41.25,39.75 a2.75,2.75 0 0 1 2.75,-2.75 a2.75,2.75 0 0 1 2.75,2.75 L 46.75,68.25 a2.75,2.75 0 0 1 -2.75,2.75 a2.75,2.75 0 0 1 -2.75,-2.75 Z" />
