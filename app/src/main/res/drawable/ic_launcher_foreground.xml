    <path android:fillColor="@color/rayik_gold_gradient" android:pathData="M 61.25,39.75 a2.75,2.75 0 0 1 2.75,-2.75 a2.75,2.75 0 0 1 2.75,2.75 L 66.75,68.25 a2.75,2.75 0 0 1 -2.75,2.75 a2.75,2.75 0 0 1 -2.75,-2.75 Z" />
